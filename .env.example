# 로컬 MySQL(compose.yaml)과 백엔드(application.yaml)가 같이 읽는다.
# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다.
# 값은 따옴표 없이 KEY=value 형태로 적는다. $ \ # 공백은 피한다.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 선택. 없으면 localhost / 3306.
# 3306을 다른 MySQL이 쓰고 있으면 MYSQL_PORT에 다른 포트(예: 3307)를 적는다.
# MYSQL_HOST=
# MYSQL_PORT=

# 사진 저장소 (결정체크리스트 F16). 경로는 backend/ 기준이며 저장소 밖을 권장한다 (예: ../../keepsy-photos).
# 서명키는 32바이트 이상. 각자 openssl rand -hex 32 로 만들고 공유하지 않는다.
APP_STORAGE_DIR=
APP_STORAGE_SIGNING_KEY=
